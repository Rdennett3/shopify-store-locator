{{ 'store-locator.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'store-locator.js' | asset_url }}"
  defer
></script>

<div
  class="store-locator"
  data-store-locator
  {{ block.shopify_attributes }}
>
  <div class="store-locator__inner">
    {% if block.settings.heading != blank %}
      <h2 class="store-locator__heading">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="store-locator__layout">
      <div class="store-locator__sidebar">
        <form
          class="store-locator__search"
          data-store-locator-search-form
        >
          <div class="store-locator__search-row">
            <input
              class="store-locator__search-input"
              type="search"
              placeholder="Enter ZIP code or address"
              aria-label="Enter ZIP code or address"
              data-store-locator-search
              disabled
            >

            <button
              class="store-locator__search-button"
              type="submit"
              data-store-locator-search-button
              disabled
            >
              Search
            </button>

            <button
              class="store-locator__location-button"
              type="button"
              data-store-locator-use-location
              disabled
            >
              Use My Location
            </button>

            <button
              class="store-locator__reset-button"
              type="button"
              data-store-locator-reset
              hidden
            >
              Reset
            </button>
          </div>

          <div
            class="store-locator__search-status"
            data-store-locator-search-status
            aria-live="polite"
          ></div>
        </form>

        <div
          class="store-locator__results"
          data-store-locator-results
        >
          <div class="store-locator__loading">Loading store locations...</div>
        </div>
      </div>

      <div class="store-locator__map-wrapper">
        <div
          class="store-locator__map"
          data-store-locator-map
        ></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Store Locator",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find a Store"
    }
  ]
}
{% endschema %}
